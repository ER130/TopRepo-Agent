# Runtime data/output folders -- these are per-user research data and
# generated results, not code. See README.md "Data folder conventions".
MS_File/
Val_File/
Train_result/
Predict_result/
TopRepo_Result/

# Build output from compiling the vendored toppic-suite C++ source locally
# -- machine-specific, not part of what's vendored. See README.md
# "Vendored code".
skills/toppic_suite/vendor/build/
skills/toppic_suite/vendor/bin/

# code.py runtime state -- created while the agent runs, session-local,
# not part of its source (tasks, memory, transcripts, persisted tool
# output, durable cron jobs, teammate mailboxes, and task-bound Git
# worktree checkouts).
.tasks/
.memory/
.transcripts/
.task_outputs/
.scheduled_tasks.json
.mailboxes/
.worktrees/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Misc
.env
.DS_Store
